// hk's own builtins and the extra builtins from nnutter/hk-config. The hk
// version in both package paths must equal the hk pin in mise.toml.
amends
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-2/hk-config@2.11.1-2#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl" as Hk
import
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-2/hk-config@2.11.1-2#/Builtins.pkl"
  as Extra

// Take a step from hk-config when it has one: those builtins exist where hk's
// own step needed a different command. Import repair and formatting run before
// the steps that need code which compiles, and `go fix` runs before the
// analyzers that read its output.
steps {
  ["constable"] = (Extra.constable) { depends = List("go_fix") }
  ["errcheck"] = (Hk.err_check) { depends = List("go_fix") }
  ["gitleaks"] = Hk.gitleaks
  ["go_check_sumtype"] = (Extra.go_check_sumtype) { depends = List("go_fumpt") }
  ["go_fix"] = (Hk.go_fix) { depends = List("go_fumpt") }
  ["go_fumpt"] = (Hk.go_fumpt) { depends = List("go_imports") }
  ["go_imports"] = Extra.go_imports
  ["go_sec"] = (Extra.go_sec) { depends = List("go_fumpt") }
  ["go_vet"] = (Hk.go_vet) { depends = List("go_fumpt") }
  ["go_vuln_check"] = (Hk.go_vuln_check) { depends = List("gomod_tidy") }
  ["gomod_tidy"] = (Hk.gomod_tidy) { depends = List("go_fix") }
  ["mdlint"] = Extra.mdlint
  ["newlines"] = Hk.newlines
  ["nilaway"] = (Extra.nilaway) { depends = List("go_fumpt") }
  ["pkl"] = (Hk.pkl) { depends = List("pkl_format") }
  ["pkl_format"] = Hk.pkl_format
  ["staticcheck"] = (Hk.staticcheck) { depends = List("go_fumpt") }
  ["testifylint"] = (Extra.testifylint) { depends = List("go_fix") }
  ["tombi"] = (Hk.tombi) { depends = List("tombi_format") }
  ["tombi_format"] = Hk.tombi_format
  ["trailing_whitespace"] = Hk.trailing_whitespace
  ["yamlfmt"] = Hk.yamlfmt
}

hooks {
  ["commit-msg"] {
    fix = true
    steps {
      ["change-id"] = Extra.timber_commit_msg
    }
  }
  ["pre-commit"] {
    fix = true
    stage = true
    stash = "git"
    steps {
      // No file filter: scan every staged change, including arbitrary types,
      // binary files, deletions, and commits without Go or Markdown changes.
      // The git-mode scan only sees text diffs, so staged binary bytes are
      // checked out to a temporary directory and scanned explicitly.
      ["gitleaks"] = (Hk.gitleaks) {
        scan = "staged"
        check =
          "gitleaks git --redact --pre-commit --staged --verbose --no-banner && tmp=$(mktemp -d) || exit $?; trap 'rm -rf \"$tmp\"' EXIT INT TERM; git diff --cached --name-only -z --diff-filter=ACMRT > \"$tmp/list\" || exit $?; git checkout-index -z --stdin --prefix=\"$tmp/tree/\" < \"$tmp/list\" || exit $?; mkdir -p \"$tmp/tree\" || exit $?; gitleaks dir --redact --verbose --no-banner \"$tmp/tree\" || exit $?"
      }
    }
  }
}
