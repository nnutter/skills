amends
  "package://github.com/nnutter/hk-config/releases/download/v2.10.0-4/hk-config@2.10.0-4#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl" as Hk
import
  "package://github.com/nnutter/hk-config/releases/download/v2.10.0-4/hk-config@2.10.0-4#/Builtins.pkl"
  as Extra

steps {
  ["gitleaks"] = Hk.gitleaks
  ["mdlint"] = Extra.mdlint
  ["newlines"] = Hk.newlines
  ["pkl"] = (Hk.pkl) { depends = List("pkl_format") }
  ["pkl_format"] = Hk.pkl_format
  // hk gives these steps every file that reads as Python, which includes the
  // scripts that carry a python shebang and no extension. A uv shebang does
  // not count: hk reads the program that the shebang names, and uv is not
  // python. So keep the python3 shebang, and call a uv script with uv run.
  ["ruff"] = Hk.ruff
  ["ruff_format"] = Hk.ruff_format
  // hk runs every step of a hook in 1 parallel group, so a check can approve a
  // file that a fixer rewrites afterwards. The dependency makes validation read
  // the file that gets committed.
  ["skills_ref"] = (Extra.skills_ref) { depends = List("mdlint") }
  ["tombi"] = (Hk.tombi) { depends = List("tombi_format") }
  ["tombi_format"] = Hk.tombi_format
  ["trailing_whitespace"] = Hk.trailing_whitespace
  ["yamlfmt"] = Hk.yamlfmt
}

hooks {
  ["commit-msg"] {
    fix = true
    steps {
      ["change-id"] = Extra.timber_commit_msg
    }
  }
}
