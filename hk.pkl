// hk's own builtins and the hook templates from nnutter/hk-config. The hk
// version in both package paths must equal the hk pin in mise.toml, and the
// hk-config revision is the newest one released for that hk version.
amends
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-6/hk-config@2.11.1-6#/Config.pkl"

import
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-6/hk-config@2.11.1-6#/Hooks.pkl"
  as Hooks

// The templates build the check, fix, pre-commit, and commit-msg hooks, and
// they order the steps of each hook that fixes: the steps that rewrite files
// run in the order their edits must land, and every step that only reads waits
// for the last fixer, so the readers run together. `check` sets no order.
// `python` covers the tests and the scripts, `toml` and `yaml` the tool and
// workflow files, and `agentskills` the skills in this repository.
hooks = Hooks.all(List("python", "toml", "yaml", "agentskills"))
